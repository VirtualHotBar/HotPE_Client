{
  "name": "hotpe-clientn",
  "private": true,
  "version": "0.0.3",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "bun run electron-forge start",
    "package": "bun run electron-forge package",
    "make": "bun run electron-forge make",
    "publish": "bun run electron-forge publish",
    "build": "bun run tsc && bun run vite build && bun run tsc -p ./src/main",
    "lint": "bun run eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "bun run vite preview"
  },
  "dependencies": {
    "iconv-lite": "^0.7.0",
    "ini": "^5.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "2.87.0-beta.0",
    "@douyinfe/semi-ui": "2.87.0-beta.0",
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-vite": "^7.9.0",
    "@eslint/js": "^9.35.0",
    "@icon-park/react": "^1.4.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-virtualized": "^9.22.2",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "electron": "^32.3.3",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "nodemon": "^3.1.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtualized": "^9.22.6",
    "react-window": "^2.1.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.20",
    "vite-plugin-react-virtualized": "^1.0.4"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "HotPE Client",
        "executableName": "hotpe-client",
        "icon": "./logo.ico",
        "extraResource": [
          "./resources/"
        ]
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "hotpe_client",
            "setupIcon": "./logo.ico",
            "requestedExecutionLevel": "highestAvailable"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main/index.ts",
                "config": "vite.main.config.ts"
              },
              {
                "entry": "src/main/preload.ts",
                "config": "vite.preload.config.ts"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  }
}
