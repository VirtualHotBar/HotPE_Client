{
  "name": "hotpe-clientn",
  "private": true,
  "version": "0.0.3",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "dev": "dev-forge.bat",
    "dev-old": "dev.bat",
    "dev-web": "vite --force",
    "dev-main": "tsc -w --p ./src/main",
    "dev-ele": "nodemon --watch ./dist/main/* --exec electron .",
    "build": "tsc && vite build && tsc -p ./src/main",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "ini": "^4.1.3",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@douyinfe/semi-icons": "^2.65.0",
    "@douyinfe/semi-ui": "^2.65.0",
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.8.3",
    "@electron-forge/maker-rpm": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/maker-zip": "^7.8.3",
    "@electron-forge/plugin-vite": "^7.8.3",
    "@icon-park/react": "^1.4.2",
    "electron": "^32.0.0",
    "@types/copyfiles": "^2.4.4",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-virtualized": "^9.21.30",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.11",
    "nodemon": "^3.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtualized": "^9.22.5",
    "react-window": "^1.8.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-react-virtualized": "^1.0.4"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "HotPE Client",
        "executableName": "hotpe-client",
        "icon": "./logo.ico",
        "extraResource": [
          "./resources/"
        ]
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "hotpe_client",
            "setupIcon": "./logo.ico",
            "requestedExecutionLevel": "highestAvailable"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main/index.ts",
                "config": "vite.main.config.ts"
              },
              {
                "entry": "src/main/preload.ts",
                "config": "vite.preload.config.ts"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  }
}
