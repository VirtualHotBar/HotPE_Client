{
  "name": "hotpe-clientn",
  "private": true,
  "version": "0.0.3",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "bun run electron-forge start",
    "package": "bun run electron-forge package",
    "make": "bun run electron-forge make",
    "publish": "bun run electron-forge publish",
    "build": "bun run tsc && bun run vite build --config vite.renderer.config.ts && bun run tsc -p ./src/main",
    "lint": "bun run eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "bun run vite preview"
  },
  "dependencies": {
    "iconv-lite": "^0.7.0"

  },
  "devDependencies": {
        "ini": "^5.0.0",
    "react-markdown": "^10.1.0",
    "@douyinfe/semi-icons": "2.87.0-beta.0",
    "@douyinfe/semi-ui": "2.87.0-beta.0",
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-deb": "^7.9.0",
    "@electron-forge/maker-rpm": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-vite": "^7.9.0",
    "@eslint/js": "^9.35.0",
    "@icon-park/react": "^1.4.2",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.18.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",

    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "electron": "^38.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-virtual": "^3.10.8",
    "typescript": "^5.9.2",
    "vite": "^6.0.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "name": "HotPE_Client",
        "executableName": "hotpe-client",
        "icon": "./logo.ico",
        "extraResource": [
          "./resources/"
        ]
      },
      "rebuildConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "win32"
          ]
        }
      ],
      "plugins": [
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main/index.ts",
                "config": "vite.main.config.ts"
              },
              {
                "entry": "src/main/preload.ts",
                "config": "vite.preload.config.ts"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  }
}
